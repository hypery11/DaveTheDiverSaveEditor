    "This file isn't a readable Dave the Diver save.": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 파일은 읽을 수 있는 《데이브 더 다이버》 세이브가 아닙니다."
          }
        },
        "zh-Hans": {
