    "That's %@ saves you've edited with DiveSaveEd": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "DiveSaveEd로 세이브를 %@번 수정하셨네요"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
