          "stringUnit": {
            "state": "translated",
            "value": "已將 %lld 種已捕魚類設為最高等級。"
          }
        }
      }
    },
    "Source Code": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "소스 코드"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "源代码"
          }
        },
        "zh-Hant": {
          "stringUnit": {
