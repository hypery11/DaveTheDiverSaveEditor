            "value": "原始碼"
          }
        }
      }
    },
    "Spent on research & recipes": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "연구·레시피에 사용"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "用于研究与料理食谱"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "用於研究與食譜"
          }
        }
      }
    },
    "Steam Cloud has a copy of this save (%@). Turn Cloud off for Dave the Diver in Steam, or it can replace your edit before the game loads.": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Steam 클라우드에 이 세이브의 복사본이 있습니다(%@). Steam에서 데이브 더 다이버의 클라우드를 끄지 않으면, 게임이 시작되기 전에 편집 내용이 교체될 수 있습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Steam 云存档中已有这份存档的副本（%@）。请在 Steam 中关闭《潜水员戴夫》的云同步，否则游戏载入前你的修改可能被替换掉。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Steam Cloud 中已有這份存檔的副本（%@）。請在 Steam 關閉《潛水員戴夫》的雲端同步，否則遊戲載入前你的修改可能會被換掉。"
          }
        }
      }
    },
    "Stock fish parts + DREDGE research parts/bones so weapon crafting is unblocked. Adds parts you haven't found yet.": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "무기 제작이 막히지 않도록 물고기 부위와 드렛지 연구 부품·뼈를 채웁니다. 아직 찾지 못한 부품도 추가됩니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "补满鱼类部件与《渔帆暗涌》研究部件／骨头，解除武器制作限制。会添加你还没找到的部件。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "備齊魚類零件與《漁帆暗湧》研究零件／骨頭，解除武器製作限制。會加入你還沒找到的零件。"
          }
        }
      }
    },
    "Stock the branch's separate ingredient counts — run alongside Max Owned.": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "분점의 별도 재고를 채웁니다 — 「보유 최대」와 함께 실행하세요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "补满分店独立计算的食材数量——建议与“已有食材拉满”配合使用。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "補滿分店獨立計算的食材數量 — 請搭配「已擁有食材補滿」一起執行。"
          }
        }
      }
    },
    "Subtract %lld from %@": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "Subtract %1$lld from %2$@"
          }
