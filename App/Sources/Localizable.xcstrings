{
  "sourceLanguage": "en",
  "strings": {
    "%@: %@": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "%1$@: %2$@"
          }
        }
      },
      "shouldTranslate": false
    },
    "A free, open-source, 100% local save editor for macOS.": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "100% 로컬에서 동작하는 macOS용 무료 오픈소스 세이브 편집기입니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "免费开源、100% 本地运行的 macOS 存档修改器。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "免費、開放原始碼、100% 在本機運作的 macOS 存檔修改器。"
          }
        }
      }
    },
    "A timestamped backup is saved automatically each time you write this save.": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 세이브를 저장할 때마다 시각이 기록된 백업이 자동으로 만들어집니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "每次写入存档时，都会自动保存一份带时间戳的备份。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "每次寫入此存檔時，都會自動建立一份帶時間戳記的備份。"
          }
        }
      }
    },
    "About %@": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 정보"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "关于 %@"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "關於 %@"
          }
        }
      }
    },
