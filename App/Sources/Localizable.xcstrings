    "Your changes were written to %@. A timestamped backup was saved first.": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "변경 사항을 %@에 저장했습니다. 시각이 기록된 백업을 먼저 만들었습니다."
          }
        },
        "zh-Hans": {
