    "An independent reimplementation in Swift — not a fork.": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "포크가 아니라 Swift로 새로 구현한 독립 프로젝트입니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "使用 Swift 独立重写实现，并非 fork。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "以 Swift 獨立重新實作，並非 fork。"
